{
  "name": "luna-frontend",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "generate:api": "npm run generate:api:luna-core && npm run generate:api:luna-task",
    "generate:api:luna-core": "openapi-typescript ../luna-core/openapi.yaml -o src/api/luna-core/schema.d.ts",
    "generate:api:luna-task": "openapi-typescript ../luna-task/openapi.yaml -o src/api/luna-task/schema.d.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/space-grotesk": "5.3.0",
    "@stomp/stompjs": "7.5.0",
    "bulma": "1.0.4",
    "i18next": "27.2.9",
    "lucide-react": "1.80.0",
    "mobx": "7.1.7",
    "mobx-react-lite": "5.1.4",
    "oidc-client-ts": "3.5.0",
    "openapi-fetch": "0.17.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-i18next": "18.0.3",
    "react-oidc-context": "3.3.1",
    "react-router": "8.5.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@testing-library/jest-dom": "8.0.0",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.13",
    "@types/node": "24.19.4",
    "@types/react": "19.3.3",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "@vitest/coverage-v8": "5.1.2",
    "eslint": "10.15.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.8",
    "globals": "17.14.0",
    "jsdom": "31.0.1",
    "openapi-typescript": "7.13.0",
    "prettier": "3.10.1",
    "sass": "1.108.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.74.0",
    "vite": "8.3.8",
    "vitest": "5.1.2"
  },
  "allowScripts": {
    "@parcel/watcher": false,
    "fsevents": false
  }
}
